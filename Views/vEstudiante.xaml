<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CcisnerosS6.Views.vEstudiante"
             Title="vEstudiante">
    <ScrollView>
        <VerticalStackLayout
            Padding="15"
            Spacing="15">

            <Label 
                Text="SEMANA 6 : CRUD ESTUDIANTES"
                FontSize="20"
                FontAttributes="Bold"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />

            <Grid Padding="10" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Text="Codigo"   FontAttributes="Bold" Grid.Column="0"/>
                <Label Text="Nombre"   FontAttributes="Bold" Grid.Column="1"/>
                <Label Text="Apellido" FontAttributes="Bold" Grid.Column="2"/>
                <Label Text="Edad"     FontAttributes="Bold" Grid.Column="3"/>
            </Grid>

            <ListView x:Name="listaEstudiantes"
                      ItemSelected="listaEstudiantes_ItemSelected">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="10" ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Label Text="{Binding codigo}"   Grid.Column="0"/>
                                <Label Text="{Binding nombre}"   Grid.Column="1"/>
                                <Label Text="{Binding apellido}" Grid.Column="2"/>
                                <Label Text="{Binding edad}"     Grid.Column="3"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button x:Name="btnAgregar"
                    Text="Agregar Estudiante"
                    Clicked="btnAgregar_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>